<?xml version="1.0" encoding="utf-8"?>
<robot name="rover" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Include Robotic Arm -->
  <xacro:include filename="$(find rover_sim)/urdf/arm.urdf.xacro" />

  <!-- Include original URDF structure -->
  <link name="base_link">
    <inertial>
      <origin xyz="-2.949E-17 1.5428E-17 -0.1" rpy="0 0 0" />
      <mass value="4.8384" />
      <inertia ixx="0.23457" ixy="3.9772E-16" ixz="2.4216E-16"
               iyy="0.23457" iyz="-1.6475E-16" izz="0.39873" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find rover_sim)/meshes/base_link.STL" />
      </geometry>
      <material name="gray">
        <color rgba="0.89804 0.91765 0.92941 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find rover_sim)/meshes/base_link.STL" />
      </geometry>
    </collision>
  </link>

  <!-- Gazebo reference for base_link -->
  <gazebo reference="base_link">
    <material>Gazebo/Grey</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <selfCollide>true</selfCollide>
  </gazebo>

  <!-- RIGHT SIDE SUSPENSION AND WHEELS -->
  <link name="Sag_suspansiyon_merkezi">
    <inertial>
      <origin xyz="-0.013037 -0.06437 -0.16884" rpy="0 0 0" />
      <mass value="1.5553" />
      <inertia ixx="0.0047177" ixy="6.8194E-08" ixz="0.00057519"
               iyy="0.015233" iyz="-5.0621E-07" izz="0.012072" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find rover_sim)/meshes/Sag_suspansiyon_merkezi.STL" />
      </geometry>
      <material name="gray">
        <color rgba="0.89804 0.91765 0.92941 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find rover_sim)/meshes/Sag_suspansiyon_merkezi.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="Sag_Suspansiyon_merkezi_joint" type="revolute">
    <origin xyz="0.045 -0.255 -0.1" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="Sag_suspansiyon_merkezi" />
    <axis xyz="0 1 0" />
    <limit lower="-0.3" upper="0.3" effort="100" velocity="1.0" />
    <dynamics damping="5.0" friction="1.0"/>
  </joint>

  <link name="right_front_wheel">
    <inertial>
      <origin xyz="3.7311E-11 0.022621 -2.5366E-11" rpy="0 0 0" />
      <mass value="1.1978" />
      <inertia ixx="0.0054603" ixy="-2.0079E-12" ixz="-1.0867E-13"
               iyy="0.01003" iyz="1.7846E-12" izz="0.0054603" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find rover_sim)/meshes/Sag_On.STL" />
      </geometry>
      <material name="blue">
        <color rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find rover_sim)/meshes/Sag_On.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="right_front_wheel_joint" type="continuous">
    <origin xyz="0.51315 -0.1837 -0.33036" rpy="0 0 0" />
    <parent link="Sag_suspansiyon_merkezi" />
    <child link="right_front_wheel" />
    <axis xyz="0 1 0" />
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <link name="right_rear_wheel">
    <inertial>
      <origin xyz="-5.3777E-12 0.022621 -4.6646E-11" rpy="0 0 0" />
      <mass value="1.1978" />
      <inertia ixx="0.0054603" ixy="5.4007E-13" ixz="4.5208E-13"
               iyy="0.01003" iyz="2.6544E-12" izz="0.0054603" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find rover_sim)/meshes/Sag_Arka.STL" />
      </geometry>
      <material name="blue">
        <color rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find rover_sim)/meshes/Sag_Arka.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="right_rear_wheel_joint" type="continuous">
    <origin xyz="-0.55762 -0.1827 -0.24797" rpy="0 0 0" />
    <parent link="Sag_suspansiyon_merkezi" />
    <child link="right_rear_wheel" />
    <axis xyz="0 1 0" />
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <!-- LEFT SIDE SUSPENSION AND WHEELS -->
  <link name="Sol_Suspensiyon_merkezi">
    <inertial>
      <origin xyz="-0.013037 0.06437 -0.16884" rpy="0 0 0" />
      <mass value="1.5553" />
      <inertia ixx="0.0047177" ixy="6.8194E-08" ixz="0.00057519"
               iyy="0.015233" iyz="-5.0621E-07" izz="0.012072" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find rover_sim)/meshes/Sol_Suspensiyon_merkezi.STL" />
      </geometry>
      <material name="gray">
        <color rgba="0.89804 0.91765 0.92941 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find rover_sim)/meshes/Sol_Suspensiyon_merkezi.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="Sol_Suspensiyon_merkezi_joint" type="revolute">
    <origin xyz="0.045 0.255 -0.1" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="Sol_Suspensiyon_merkezi" />
    <axis xyz="0 1 0" />
    <limit lower="-0.3" upper="0.3" effort="100" velocity="1.0" />
    <dynamics damping="5.0" friction="1.0"/>
  </joint>

  <link name="left_front_wheel">
    <inertial>
      <origin xyz="-1.4454E-11 -0.022621 4.9675E-11" rpy="0 0 0" />
      <mass value="1.1978" />
      <inertia ixx="0.0054603" ixy="-7.7309E-13" ixz="-8.3628E-13"
               iyy="0.01003" iyz="2.6571E-12" izz="0.0054603" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find rover_sim)/meshes/Sol_On.STL" />
      </geometry>
      <material name="blue">
        <color rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find rover_sim)/meshes/Sol_On.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="left_front_wheel_joint" type="continuous">
    <origin xyz="0.52892 0.1827 -0.30434" rpy="0 0 0" />
    <parent link="Sol_Suspensiyon_merkezi" />
    <child link="left_front_wheel" />
    <axis xyz="0 1 0" />
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <link name="left_rear_wheel">
    <inertial>
      <origin xyz="-6.0615E-11 -0.022621 1.1053E-11" rpy="0 0 0" />
      <mass value="1.1978" />
      <inertia ixx="0.0054603" ixy="-2.8483E-12" ixz="4.1807E-13"
               iyy="0.01003" iyz="4.2492E-13" izz="0.0054603" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find rover_sim)/meshes/Sol_Arka.STL" />
      </geometry>
      <material name="blue">
        <color rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find rover_sim)/meshes/Sol_Arka.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="left_rear_wheel_joint" type="continuous">
    <origin xyz="-0.54459 0.1827 -0.27547" rpy="0 0 0" />
    <parent link="Sol_Suspensiyon_merkezi" />
    <child link="left_rear_wheel" />
    <axis xyz="0 1 0" />
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <!-- Gazebo material and friction for wheels -->
  <gazebo reference="right_front_wheel">
    <material>Gazebo/Blue</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
  </gazebo>

  <gazebo reference="right_rear_wheel">
    <material>Gazebo/Blue</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
  </gazebo>

  <gazebo reference="left_front_wheel">
    <material>Gazebo/Blue</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
  </gazebo>

  <gazebo reference="left_rear_wheel">
    <material>Gazebo/Blue</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
  </gazebo>

  <!-- Süspansiyon Spring Parametreleri -->
  <gazebo reference="Sag_Suspansiyon_merkezi_joint">
    <springStiffness>500</springStiffness>
    <springReference>0</springReference>
  </gazebo>

  <gazebo reference="Sol_Suspensiyon_merkezi_joint">
    <springStiffness>500</springStiffness>
    <springReference>0</springReference>
  </gazebo>

  <!-- ===================== ROS2 CONTROL ===================== -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <!-- Right Front Wheel -->
    <joint name="right_front_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- Right Rear Wheel -->
    <joint name="right_rear_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- Left Front Wheel -->
    <joint name="left_front_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- Left Rear Wheel -->
    <joint name="left_rear_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- ========== ARM JOINTS ========== -->
    <!-- Arm Joint 1 - Base rotation -->
    <joint name="arm_joint1">
      <command_interface name="position">
        <param name="min">-3.14159</param>
        <param name="max">3.14159</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- Arm Joint 2 - Shoulder -->
    <joint name="arm_joint2">
      <command_interface name="position">
        <param name="min">-1.57</param>
        <param name="max">1.57</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- Arm Joint 3 - Elbow -->
    <joint name="arm_joint3">
      <command_interface name="position">
        <param name="min">-2.0</param>
        <param name="max">2.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- Arm Joint 4 - Wrist pitch -->
    <joint name="arm_joint4">
      <command_interface name="position">
        <param name="min">-2.0</param>
        <param name="max">2.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- Arm Joint 5 - Wrist roll -->
    <joint name="arm_joint5">
      <command_interface name="position">
        <param name="min">-3.14159</param>
        <param name="max">3.14159</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- Gazebo plugin for ros2_control -->
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find rover_sim)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
